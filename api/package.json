{
  "name": "alemitu-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env scripts/seed-dev.mjs seed",
    "unseed": "node --env-file=.env scripts/seed-dev.mjs unseed",
    "create-admin": "node --env-file=.env --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
